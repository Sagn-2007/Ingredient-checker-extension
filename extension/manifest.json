{
  "manifest_version": 3,
  "name": "Ingredient Label Checker",
  "version": "1.0",
  "description": "Check if food ingredients fit your diet while shopping online.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
